CSS
/* General Page Background & Body Setup */
body {
    font-family: 'Baskerville', 'Palatino', 'Georgia', serif;
    background-color: #e8eef7;
    color: #333333;
    line-height: 1.6;
    margin: 0;
    padding: 20px;
}

/* Outer Container Layout */
main, header {
    max-width: 850px;
    margin: 20px auto;
    background-color: #ffffff;
    padding: 30px 40px;
    border-radius: 6px;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.05);
    text-align: center;
}

/* Headings */
h1 {
    color: #2b3a4e;
    font-size: 2.2em;
    margin-bottom: 5px;
}

h2 {
    color: #4a627a;
    border-bottom: 2px solid #cbd6e2;
    padding-bottom: 5px;
    margin-top: 25px;
}

h3 {
    color: #5c748f;
}

/* --- Week 6: Navigation & Positioning Styles --- */

.headerWrapper {
    margin-top: 20px;
    padding: 10px 0;
}

/* Navbar Class Container */
.navbar {
    background-color: #d2dee9;
    border-radius: 25px;
    padding: 8px 15px;
    display: inline-block;
}

/* Turn bulleted list horizontal & remove bullets */
.navbar ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
}

.navbar li {
    display: inline;
}

.navbar a {
    color: #2c4460;
    text-decoration: none;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 15px;
    transition: background-color 0.3s ease;
    font-size: 0.9em;
}

.navbar a:hover {
    background-color: #4a627a;
    color: #ffffff;
}

/* Content Sections & Lists */
section {
    text-align: left;
    margin-bottom: 25px;
}

ul {
    margin-left: 20px;
}

/* Responsive Images */
img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 15px auto;
}

/* Footer Styling */
footer {
    text-align: center;
    padding: 20px;
    font-size: 0.9em;
}

footer a {
    color: #2c4460;
    text-decoration: none;
    font-weight: bold;
}